{
  "name": "murmur",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "The Two Voices: you are one person's inner voice through an ordinary week. Every evening they look back.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "node scripts/deploy.ts",
    "check:lane": "npm run check",
    "knip": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "3.0.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.10.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.11.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "knip": "6.43.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@adam0white/human-framework": "$@adam0white/human-framework"
  }
}
